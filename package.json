{
  "name": "gestion-solicitudes-academicas",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Solicitudes Académicas",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "demo": "npm run --silent build && node dist/src/demo.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests",
    "metricas": "node scripts/metricas.mjs src",
    "pretest": "npm run --silent build",
    "test": "node --test --test-reporter=spec \"dist/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "eslint": "10.1.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
